  "devDependencies": {
    "@biomejs/biome": "^2.3.10",
    "@types/jest-image-snapshot": "^6.4.0",
    "@types/lodash": "^4.17.21",
    "@types/node": "^25.0.3",
    "@types/pdfkit": "^0.17.4",
    "@types/qrcode": "^1.5.6",
    "@vitest/ui": "^4.0.16",
    "iconv-lite": "^0.7.1",
    "jest-image-snapshot": "^6.5.1",
    "jsdom": "^29.1.1",
    "lodash": "^4.17.21",
    "npm-run-all": "^4.1.5",
    "pdf-to-png-converter": "^4.0.0",
    "prettier": "^3.7.4",
    "rimraf": "^6.1.2",
    "rolldown": "^1.0.3",
    "typescript": "^6.0.3",
    "vitest": "^4.0.16"
  }
}
