{
  "name": "@bbitgmbh/bbit.swiss-qr-bill",
  "version": "6.0.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "author": "Yannik Eicher <ache@bbit.io>",
  "license": "SEE LICENSE IN LICENSE.md",
  "scripts": {
    "clean": "rimraf coverage dist junit.xml",
    "test": "vitest run",
    "lint": "biome lint ./src",
    "biome:check": "biome check --apply ./src",
    "types": "tsc --emitDeclarationOnly",
    "bundle": "rolldown -c rolldown.config.ts",
    "build": "run-s clean bundle types",
    "yalc": "nr build && yalc push",
    "bbitprecommit": "run-p lint test build"
  },
  "files": [
    "dist/**/*",
    "!dist/interfaces/**/*",
    "readme.md"
