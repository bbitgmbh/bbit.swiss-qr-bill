{
  "compilerOptions": {
    "strict": true,
    "declaration": true,
    "declarationDir": "./dist",
    "rootDir": "./src",
    "target": "es2022",
    "lib": ["es2022", "dom"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noImplicitAny": false,
    "removeComments": true,
    "preserveConstEnums": true,
    "sourceMap": true,
    "outDir": "dist",
    "experimentalDecorators": true,
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*"],
  "exclude": ["**/*.spec.ts", "src/__mocks__/**", "src/test-utils.ts", ".yalc/**/*"]
}
